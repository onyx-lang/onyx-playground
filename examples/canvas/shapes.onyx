// One frame of drawing: rectangles, arcs, curves, and text.
// Right-click this file and choose Run this file.

use core {*}
use canvas

main :: () {
    canvas.init();
    w, h := canvas.get_size();

    canvas.fill_style("#18181b");
    canvas.fill_rect(0.0f, 0.0f, w, h);

    canvas.fill_style("#7aa2f7");
    canvas.font("28px sans-serif");
    canvas.text_align(canvas.TextAlign.Left);
    canvas.fill_text("Canvas", 28.0f, 48.0f);

    bars := f32.[ 0.35f, 0.62f, 0.48f, 0.80f, 0.55f ];
    bar_w := 28.0f;
    base_y := h * 0.78f;
    for i in 0 .. 5 {
        bh := bars[i] * h * 0.45f;
        canvas.fill_style("#7aa2f7");
        if i % 2 == 1 do canvas.fill_style("#56b6c2");
        canvas.fill_rect(28.0f + cast(f32) i * (bar_w + 10.0f), base_y - bh, bar_w, bh);
    }

    canvas.fill_style("#c678dd");
    canvas.begin_path();
    canvas.arc(w * 0.55f, h * 0.42f, 48.0f, 0.0f, math.TAU);
    canvas.fill();

    canvas.stroke_style("#e5c07b");
    canvas.line_width(4.0f);
    canvas.begin_path();
    canvas.ellipse(w * 0.55f, h * 0.42f, 78.0f, 36.0f, 0.4f, 0.0f, math.TAU);
    canvas.stroke();

    canvas.stroke_style("#98c379");
    canvas.line_width(3.0f);
    canvas.begin_path();
    canvas.move_to(w * 0.75f, h * 0.28f);
    canvas.line_to(w * 0.90f, h * 0.58f);
    canvas.line_to(w * 0.62f, h * 0.58f);
    canvas.close_path();
    canvas.stroke();

    canvas.stroke_style("#e06c75");
    canvas.begin_path();
    canvas.move_to(28.0f, h * 0.90f);
    canvas.quadratic_curve_to(w * 0.30f, h * 0.70f, w * 0.50f, h * 0.90f);
    canvas.bezier_curve_to(w * 0.65f, h * 1.05f, w * 0.80f, h * 0.72f, w - 28.0f, h * 0.88f);
    canvas.stroke();

    canvas.sync();
}
