use core {*}

main :: () {
    println("Examples");
    println("");
    println("Press Run to start the file named beside the play button.");
    println("The menu beside Run can run the open file, or set it as the startup file.");
    println("Animations keep going until you press Stop.");
    println("");
    println("hello.onyx             prints a greeting");
    println("guess.onyx             a number guessing game");
    println("canvas/shapes.onyx     rectangles, arcs, curves, and text");
    println("canvas/bounce.onyx     animated bouncing balls");
    println("canvas/waves.onyx      moving sine waves");
    println("canvas/particles.onyx  falling particles");
    println("canvas/paint.onyx      draw with the mouse");
    println("canvas/follow.onyx     a circle that follows the cursor");
    println("canvas/clock.onyx      an analog clock");
}
